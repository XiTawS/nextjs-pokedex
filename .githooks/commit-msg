#!/bin/sh
# Impose les commits conventionnels : type(portée optionnelle): description
# Ex. : feat(pokeapi): affiche les 151 premiers Pokémon
head -n1 "$1" | grep -qE '^((feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: .+|Merge .+|(fixup|squash)! .+)$' && exit 0
echo "Message non conventionnel. Format : type(portée): description" >&2
echo "Types : feat fix docs style refactor perf test build ci chore revert" >&2
exit 1
